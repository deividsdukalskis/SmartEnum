<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>11.0</LangVersion>
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
		<Nullable>enable</Nullable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeSmartEnumAnalyzerInPackage</TargetsForTfmSpecificContentInPackage>
		<IsRoslynComponent>true</IsRoslynComponent>
		<PackageId>SmartEnum</PackageId>
		<Version>0.1.0</Version>
		<Authors>deividsdukalskis</Authors>
		<RepositoryUrl>https://github.com/deividsdukalskis/SmartEnum</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Compile-time analyzers and construction generators for typed SmartEnum hierarchies.</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
		<None Include="../README.md" Pack="true" PackagePath="/" />
	</ItemGroup>

	<!-- Include build output only while packing, not as an IDE project item. -->
	<Target Name="IncludeSmartEnumAnalyzerInPackage">
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
		</ItemGroup>
	</Target>

</Project>
